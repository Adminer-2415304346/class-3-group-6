' ? \'dark\' : \'light\';\n                    return window.themeManager.apply(current === \'dark\' ? \'light\' : \'dark\');\n                }\n            };\n        })();\n    </script>\n\n    <!-- \xe8\xb5\x84\xe6\xba\x90\xe6\x8f\x90\xe7\xa4\xba\xe4\xbc\x98\xe5\x8c\x96 -->\n    <!-- \xe4\xbb\x85\xe4\xbf\x9d\xe7\x95\x99\xe7\x9c\x9f\xe6\xad\xa3\xe9\x9c\x80\xe8\xa6\x81\xe7\x9a\x84 dns-prefetch\xef\xbc\x8cMathJax \xe7\x94\xb1\xe6\x99\xba\xe8\x83\xbd\xe5\x8a\xa0\xe8\xbd\xbd\xe5\x99\xa8\xe6\x8c\x89\xe9\x9c\x80\xe5\x8a\xa0\xe8\xbd\xbd -->\n    <link rel="dns-prefetch" href="//cdn.jsdelivr.net"/>\n\n    <!-- RSS\xe5\x92\x8c\xe5\x9b\xbe\xe6\xa0\x87 -->\n    <link rel="alternate" type="application/rss+xml" title="djangoblog &raquo; Feed" href="/feed"/>\n    \n\n<link rel="icon" href="/static/blog/favicon-32.png?v=relay-1" type="image/png" sizes="32x32">\n<link rel="icon" href="/static/blog/favicon.svg?v=relay-1" type="image/svg+xml" sizes="any">\n<link rel="apple-touch-icon" href="/static/blog/apple-touch-icon.png?v=relay-1" sizes="180x180">\n\n\n    <!-- \xe5\x85\xb3\xe9\x94\xaeCSS\xef\xbc\x9a\xe9\x98\xb2\xe6\xad\xa2\xe6\xb7\xb1\xe8\x89\xb2\xe6\xa8\xa1\xe5\xbc\x8f\xe9\x97\xaa\xe7\x83\x81\xef\xbc\x88\xe4\xbb\x85\xe9\xa6\x96\xe5\xb1\x8f\xe5\x85\x9c\xe5\xba\x95\xef\xbc\x8c\xe6\x9c\x80\xe7\xbb\x88\xe9\xa2\x9c\xe8\x89\xb2\xe7\x94\xb1 main.css \xe7\x9a\x84 token \xe5\x86\xb3\xe5\xae\x9a\xef\xbc\x89\n         \xe6\xb3\xa8\xe6\x84\x8f\xef\xbc\x9a\xe8\xbf\x99\xe9\x87\x8c\xe4\xb8\x8d\xe5\x86\x8d\xe7\x94\xa8 !important \xe6\x8a\xa2 main.css \xe7\x9a\x84\xe8\x83\x8c\xe6\x99\xaf\xe6\x8e\xa7\xe5\x88\xb6\xe6\x9d\x83\xef\xbc\x8c\xe4\xb8\xa4\xe5\xa4\x84\xe8\x89\xb2\xe5\x80\xbc\xe5\xbf\x85\xe9\xa1\xbb\xe4\xb8\x8e token \xe4\xbf\x9d\xe6\x8c\x81\xe4\xb8\x80\xe8\x87\xb4 -->\n    <style>\n        :root {\n            --bootstrap-bg-light: 255 255 255;   /* == --background */\n            --bootstrap-fg-light: 24 24 27;      /* == --foreground */\n            --bootstrap-bg-dark: 13 13 17;\n            --bootstrap-fg-dark: 237 237 242;\n            --bootstrap-skeleton-base: 246 246 248;\n            --bootstrap-skeleton-high: 228 228 231;\n        }\n\n        html,\n        html body {\n            background-color: rgb(var(--bootstrap-bg-light));\n            color: rgb(var(--bootstrap-fg-light));\n        }\n\n        html[data-theme="dark"],\n        html[data-theme="dark"] body {\n            background-color: rgb(var(--bootstrap-bg-dark));\n            color: rgb(var(--bootstrap-fg-dark));\n        }\n\n        body {\n            margin: 0;\n            padding: 0;\n            font-family: "Open Sans", -apple-system, BlinkMacSystemFont, "Segoe UI",\n                "PingFang SC", "HarmonyOS Sans SC", "Hiragino Sans GB", "Microsoft YaHei",\n                "Noto Sans SC", sans-serif;\n            line-height: 1.7;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        #page {\n            min-height: 100vh;\n            min-height: 100dvh;\n            display: flex;\n            flex-direction: column;\n        }\n\n        /* z-index \xe5\x88\x86\xe5\xb1\x82\xef\xbc\x9a\xe6\xb5\xae\xe5\xb1\x82(60) > \xe7\xab\x99\xe7\x82\xb9\xe5\xa4\xb4\xe9\x83\xa8(40) > \xe6\x99\xae\xe9\x80\x9a\xe5\x86\x85\xe5\xae\xb9 */\n        #masthead {\n            position: relative;\n            z-index: 40;\n        }\n\n        #main {\n            flex: 1;\n        }\n\n        .skeleton {\n            background: linear-gradient(90deg,\n                rgb(var(--bootstrap-skeleton-base)) 25%,\n                rgb(var(--bootstrap-skeleton-high)) 50%,\n                rgb(var(--bootstrap-skeleton-base)) 75%);\n            background-size: 200% 100%;\n            animation: loading 1.5s infinite;\n        }\n\n        @keyframes loading {\n            0% { background-position: 200% 0; }\n            100% { background-position: -200% 0; }\n        }\n\n        [x-cloak] {\n            display: none !important;\n        }\n    </style>\n\n    <!-- \xe5\xad\x97\xe4\xbd\x93\xe4\xbc\x98\xe5\x8c\x96\xe5\x8a\xa0\xe8\xbd\xbd\xef\xbc\x9a\xe4\xbd\xbf\xe7\x94\xa8\xe5\xaa\x92\xe4\xbd\x93\xe6\x9f\xa5\xe8\xaf\xa2\xe5\xbb\xb6\xe8\xbf\x9f\xe9\x9d\x9e\xe5\x85\xb3\xe9\x94\xae\xe5\xad\x97\xe4\xbd\x93 -->\n    <link rel="stylesheet" href="/static/blog/fonts/open-sans.css" media="print" onload="this.media=\'all\'; this.onload=null;">\n    <noscript><link rel="stylesheet" href="/static/blog/fonts/open-sans.css"></noscript>\n\n    <!-- \xe4\xbb\xa3\xe7\xa0\x81\xe9\xab\x98\xe4\xba\xae\xe6\xa0\xb7\xe5\xbc\x8f\xef\xbc\x88Pygments\xef\xbc\x89 - \xe5\xbc\x82\xe6\xad\xa5\xe5\x8a\xa0\xe8\xbd\xbd\xef\xbc\x8c\xe4\xbb\x85\xe5\x9c\xa8\xe6\x9c\x89\xe4\xbb\xa3\xe7\xa0\x81\xe5\x9d\x97\xe6\x97\xb6\xe9\x9c\x80\xe8\xa6\x81 -->\n    <link rel="stylesheet" href="/static/pygments/default.css" media="print" onload="this.media=\'all\'; this.onload=null;">\n    <noscript><link rel="stylesheet" href="/static/pygments/default.css"></noscript>\n\n    <!-- \xe6\x96\xb0\xe5\x89\x8d\xe7\xab\xaf\xef\xbc\x9aTailwind CSS + Alpine.js - \xe5\xae\x8c\xe6\x95\xb4\xe6\xa0\xb7\xe5\xbc\x8f\xe7\xb3\xbb\xe7\xbb\x9f\xef\xbc\x88\xe9\x80\x9a\xe8\xbf\x87JS\xe5\x8a\xa0\xe8\xbd\xbd\xef\xbc\x89 -->\n    \n\n<style>\n    @view-transition { navigation: auto; }\n    @media (prefers-reduced-motion: reduce) {\n        @view-transition { navigation: none; }\n    }\n</style>\n\n<script src="/static/blog/js/accountTransitions.js?v=5"></script>\n\n    <link rel="modulepreload" crossorigin href="/static/blog/dist/js/main-CEZ5XIVw.js">\n    \n    <!-- Vite\xe7\x94\x9f\xe4\xba\xa7\xe6\xa8\xa1\xe5\xbc\x8f -->\n    <link rel="stylesheet" href="/static/blog/dist/css/main-C_vVv2Od.css">\n    <script type="module" crossorigin src="/static/blog/dist/js/main-CEZ5XIVw.js"></script>\n\n\n    <!-- \xe6\x8f\x92\xe4\xbb\xb6CSS\xe6\x96\x87\xe4\xbb\xb6 -->\n    <link rel="stylesheet" href="/static/article_recommendation/static/article_recommendation/css/reco